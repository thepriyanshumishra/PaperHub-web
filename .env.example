# ==============================================================================
# PaperHub 2.0 — Production Environment Variables Configuration Template
# Copy this file to .env.local (for local dev) or configure in Vercel settings.
# Do NOT check actual secret keys into source control.
# ==============================================================================

# ─── Database & Caching Configurations ────────────────────────────────────────
# MongoDB Atlas connection string. Use a dedicated cluster for production.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_endpoint>/paperhub?retryWrites=true&w=majority

# Secure Redis Connection String (Upstash). TLS (rediss://) is required in production.
REDIS_URL=rediss://default:<redis_password>@<redis_endpoint>.upstash.io:6379

# ─── Better Auth Configurations ────────────────────────────────────────────────
# 32-byte hexadecimal secret key (Generate via: openssl rand -hex 32)
BETTER_AUTH_SECRET=your_32_character_hex_auth_secret

# The canonical base URL of your deployed application
BETTER_AUTH_URL=https://your-custom-domain.com

# ─── Integration API Keys ─────────────────────────────────────────────────────
# Resend email delivery service API key
RESEND_API_KEY=re_yourResendApiKeyHere

# Groq Console API Key (for LLM solve/evaluation queries)
GROQ_API_KEY=gsk_yourGroqApiKeyHere

# ─── Firebase Frontend Client Configurations ──────────────────────────────────
# Required for initializeApp() on the client-side. Keep values identical to Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD_your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-MEASUREMENT_ID
